---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { courses } from '../data/courses';
---

<BaseLayout title="The Computing Portal" description="Computing resources for Geeky Teacher classes.">
  <section class="intro">
    <p class="eyebrow">Geeky Teacher</p>
    <h1>The Computing Portal</h1>
    <p>Choose your class to find its computing resources.</p>
  </section>
  <section class="course-grid" aria-label="Classes">
    {courses.map((course) => (
      <ResourceCard
        title={course.title}
        description={course.description}
        href={`/${course.slug}/`}
      />
    ))}
  </section>
</BaseLayout>